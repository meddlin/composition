{
  "name": "composition",
  "private": true,
  "description": "Root task runner for the composition monorepo. Each app keeps its own toolchain.",
  "scripts": {
    "lint:actions": "node scripts/lint-github-actions.mjs",
    "opengrep": "node scripts/opengrep.mjs",
    "opengrep:cli": "node scripts/opengrep.mjs cli",
    "opengrep:desktop": "node scripts/opengrep.mjs desktop",
    "opengrep:web": "node scripts/opengrep.mjs web",
    "manual:backup": "bash scripts/manual-tests/backup-restore.sh",
    "manual:backup:selftest": "pnpm --dir apps/cli manual:backup selftest",
    "manual:todo": "node apps/desktop/scripts/todo-manual.mjs",
    "manual:sheet": "node apps/desktop/scripts/sheet-manual.mjs",
    "manual:stress": "bash apps/web/scripts/sample-db/stress-test.sh",
    "manual:stress:lines": "bash apps/web/scripts/sample-db/stress-test.sh --lines",
    "test": "pnpm run test:scripts && pnpm run test:web && pnpm run test:desktop",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:cli": "pnpm --dir apps/cli test",
    "test:web": "pnpm --dir apps/web test",
    "test:desktop": "pnpm --dir apps/desktop run typecheck && pnpm --dir apps/desktop test",
    "test:cli:types": "pnpm --dir apps/cli typecheck"
  },
  "packageManager": "pnpm@11.0.3"
}
