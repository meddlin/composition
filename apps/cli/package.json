{
  "name": "composition-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Composition terminal app (OpenTUI, Node 26)",
  "type": "module",
  "bin": {
    "composition": "bin/composition.mjs"
  },
  "engines": {
    "node": ">=26.10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node bin/composition.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/build.mjs && node dist/seed.mjs",
    "search:playground": "node scripts/build.mjs && node dist/search-playground.mjs"
  },
  "dependencies": {
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^5.4.2",
    "lowlight": "^3.3.0",
    "react": "19.3.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "typescript": "^7",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.0.3"
}
