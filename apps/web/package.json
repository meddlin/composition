{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others --names next,meili --prefix-colors cyan,magenta \"pnpm dev\" \"pnpm meili\"",
    "build": "next build",
    "start": "next start",
    "fetch:drawio": "node scripts/fetch-drawio.mjs",
    "copy:pdfjs": "node scripts/copy-pdfjs.mjs",
    "stress:db": "node scripts/sample-db/generate.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "meili": "meilisearch --http-addr 127.0.0.1:7700 --master-key \"$(cat $HOME/.composition/meili_master_key)\" --db-path $HOME/.composition-web/meili_data --no-analytics"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-math": "0.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fontkit": "2.0.4",
    "js-yaml": "^4.3.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.62.0",
    "meilisearch": "^0.62.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.5.438",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.8.1"
