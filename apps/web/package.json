{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --kill-others --names next,meili --prefix-colors cyan,magenta \"pnpm dev\" \"pnpm meili\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "meili": "meilisearch --http-addr 127.0.0.1:7700 --master-key \"$(cat $HOME/.composition/meili_master_key)\" --db-path $HOME/.composition-web/meili_data --no-analytics"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "js-yaml": "^4.3.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.49.0",
    "meilisearch": "^0.62.0",
    "next": "16.3.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
