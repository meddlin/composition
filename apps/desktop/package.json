{
  "name": "composition-desktop",
  "productName": "Composition",
  "version": "0.6.2",
  "private": true,
  "description": "Composition desktop app (Electron)",
  "homepage": "https://github.com/meddlin/composition",
  "main": "dist/main.js",
  "desktopName": "composition-desktop.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-renderer.mjs && node scripts/build-main.mjs && node scripts/collect-licenses.mjs",
    "build:main": "node scripts/build-main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:reading-list": "node scripts/smoke-reading-list.mjs",
    "smoke:rss": "node scripts/smoke-rss.mjs",
    "package": "pnpm build && electron-builder --dir -c.mac.identity=null",
    "dist": "pnpm build && electron-builder",
    "release": "node scripts/release.mjs",
    "fetch:meilisearch": "node scripts/fetch-meilisearch.mjs",
    "fetch:node": "node scripts/fetch-node.mjs",
    "stage:cli": "node scripts/stage-cli.mjs",
    "dist:linux": "pnpm build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "@rowanmanning/feed-parser": "2.1.5",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.0.3"
}
