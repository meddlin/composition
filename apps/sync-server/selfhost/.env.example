# Copy to .env (next to compose.yaml). Everything here is optional.

# Where the server listens on the host. Leave it on loopback unless something with HTTPS is in front.
#SYNC_BIND=127.0.0.1
#SYNC_PORT=8787

# Backup folder on the host (a second disk or a NAS mount is better than the same disk).
#BACKUP_DIR=./backup

# Or back up to an S3-compatible bucket instead (Cloudflare R2 shown).
#LITESTREAM_BUCKET=composition-sync
#LITESTREAM_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#LITESTREAM_REGION=auto
#LITESTREAM_ACCESS_KEY_ID=
#LITESTREAM_SECRET_ACCESS_KEY=

# Only for `docker compose --profile https up -d`: the name your DNS points at this machine (ports 80 and 443 must reach it).
#SYNC_DOMAIN=sync.example.com
