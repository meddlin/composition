<Window
    x:Class="Composition.Shell.Spike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Composition: shell spike">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Label="Load 5,000-line note" Icon="OpenFile" Click="LoadNote_Click" />
            <AppBarButton Label="Colour all" Icon="FontColor" Click="ColourAll_Click" />
            <AppBarButton Label="Type 200 characters (timed)" Icon="Edit" Click="Type_Click" />
            <AppBarButton Label="Render preview" Icon="View" Click="Render_Click" />
            <AppBarButton Label="Run all, write results" Icon="Save" Click="RunAll_Click" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RichEditBox x:Name="Editor" Grid.Column="0" Margin="8" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="Cascadia Mono" AutomationProperties.Name="Markdown editor" />
            <controls:WebView2 x:Name="Preview" Grid.Column="1" Margin="8" />
        </Grid>

        <TextBlock x:Name="Status" Grid.Row="2" Margin="12,4" TextWrapping="Wrap" />
    </Grid>
</Window>
